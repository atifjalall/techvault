// Enhanced Prisma Schema for Professional Product Variant System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required tables (keeping existing)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  phone             String?
  bio               String?
  isVerified        Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  twoFactorEnabled    Boolean   @default(false)
  phoneVerified       Boolean   @default(false)
  lastPasswordChange  DateTime? @default(now())
  
  businessAddress     Json?
  notificationSettings Json?
  privacySettings     Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deleteAt          DateTime?
  role              Role      @default(CUSTOMER)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  variantCartItems VariantCartItem[]  // NEW: For variant-specific cart items
  wishlistItems WishlistItem[]

  products       Product[]       @relation("VendorProducts")
  transactions   Transaction[]
  vendorSettings VendorSettings?
  notifications  Notification[]  @relation("UserNotifications")
  
  savedPaymentMethods SavedPaymentMethod[]
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedPaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  
  stripePaymentMethodId String
  last4Digits   String
  cardBrand     String
  expiryMonth   Int
  expiryYear    Int
  
  billingName   String
  billingEmail  String?
  billingAddress Json?
  
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  nickname      String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([stripePaymentMethodId])
}

// Product Structure
model Category {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  description  String?
  image        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id])
  products  Product[] @relation("SubcategoryProducts")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logo      String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Enhanced Product Model - Base product without variants
model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  
  // Base product images (general/default images)
  images         String[]  @default([])
  
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id])
  
  // Computed fields from variants
  basePrice      Decimal?  @db.Decimal(10, 2)  // Starting price from cheapest variant
  totalStock     Int       @default(0)          // Sum of all variant stocks
  
  // SEO and discoverability
  tags           String[]  @default([])
  modelNumber    String?
  views          Int       @default(0)
  sold           Int       @default(0)
  
  // Product status
  isActive       Boolean   @default(true)
  featured       Boolean   @default(false)
  newArrival     Boolean   @default(false)
  returnable     Boolean   @default(true)
  
  // Shipping and warranty
  deliveryDays   Int?      @default(3)
  warranty       String?   // e.g., "2 years", "1 year"
  
  // Physical properties (shared across variants)
  weight         String?
  dimensions     String?   // L×W×H format
  
  categoryId    String
  subcategoryId String?
  vendorId      String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  category      Category       @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?   @relation("SubcategoryProducts", fields: [subcategoryId], references: [id])
  vendor        User           @relation("VendorProducts", fields: [vendorId], references: [id])
  
  // Enhanced relations
  variants      ProductVariant[]
  specifications ProductSpecification[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[] @relation("ProductWishlistItems")
  notifications Notification[] @relation("ProductNotifications")
  
  @@index([vendorId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([featured])
}

// New: Product Variants - The actual purchasable items
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  
  // Variant identification
  variantName   String   // e.g., "Space Black - 256GB", "2 meters", "27 inch"
  sku           String?  @unique
  
  // Pricing
  price         Decimal  @db.Decimal(10, 2)
  comparePrice  Decimal? @db.Decimal(10, 2)
  
  // Stock management
  stock         Int      @default(0)
  lowStockAlert Int      @default(10)
  
  // Variant-specific attributes (flexible JSON for different product types)
  color         String?
  colorHex      String?
  storage       String?  // "256GB", "512GB"
  ram           String?  // "8GB", "16GB"
  size          String?  // For monitors, tablets: "27 inch", "12.9 inch"
  length        String?  // For cables: "1m", "2m", "5m"
  material      String?  // "Aluminum", "Leather", "Silicone"
  
  // Additional flexible attributes
  attributes    Json?    // For any other variant-specific properties
  
  // Variant images
  images        String[] @default([])
  thumbnailImage String? // Main image for variant selector
  
  // Status
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     VariantCartItem[]
  orderItems    VariantOrderItem[]
  
  wishlistItems    WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([stock])
  @@index([isActive])
}

// Enhanced Product Specifications with Categories
model ProductSpecification {
  id          String   @id @default(cuid())
  productId   String
  
  // Specification organization
  category    String   // "Display", "Performance", "Camera", "Connectivity"
  name        String   // "Screen Size", "Processor", "Main Camera"
  value       String   // "6.7 inches", "A17 Pro", "48MP"
  unit        String?  // "inches", "GB", "MP", "hours"
  
  // Ordering and importance
  categoryOrder Int    @default(0) // Order of categories
  specOrder     Int    @default(0) // Order within category
  isHighlight   Boolean @default(false) // Important specs to highlight
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([category])
  @@index([categoryOrder])
  @@index([specOrder])
}

// Updated Cart System for Variants
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// New: Variant-specific cart items
model VariantCartItem {
  id              String   @id @default(cuid())
  userId          String
  productVariantId String
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@index([userId])
  @@index([productVariantId])
}

model WishlistItem {
  id               String   @id @default(cuid())
  userId           String
  productId        String
  productVariantId String?  // Add this
  createdAt        DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product         @relation("ProductWishlistItems", fields: [productId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade) // Add this

  @@unique([userId, productId, productVariantId]) // Update this
  @@index([userId])
  @@index([productId])
  @@index([productVariantId]) // Add this
}

// Order System
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  
  trackingNumber  String?
  shippingCarrier String?
  estimatedDelivery DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  
  total           Decimal     @db.Decimal(10, 2)
  subtotal        Decimal?    @db.Decimal(10, 2)
  taxAmount       Decimal     @db.Decimal(10, 2) @default(0)
  shippingCost    Decimal     @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal     @db.Decimal(10, 2) @default(0)
  
  shippingAddress Json
  billingAddress  Json?
  
  paymentIntentId String?
  paymentMethod   String?
  paymentStatus   PaymentStatus @default(PENDING)
  
  notes           String?
  customerNotes   String?
  priority        OrderPriority @default(NORMAL)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
  variantItems VariantOrderItem[]
  notifications  Notification[] @relation("OrderNotifications")
  statusHistory  OrderStatusHistory[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// New: Variant-specific order items
model VariantOrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productVariantId String
  quantity        Int
  price           Decimal @db.Decimal(10, 2)
  
  // Store variant details at time of order for historical accuracy
  variantSnapshot Json    // Store variant details like color, storage, etc.

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  
  @@index([orderId])
  @@index([productVariantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

// Reviews
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// Additional models (keeping existing)
model Notification {
  id          String      @id @default(cuid())
  userId      String?
  productId   String?
  orderId     String?
  type        NotificationType
  severity    NotificationSeverity @default(INFO)
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User?    @relation("UserNotifications", fields: [userId], references: [id])
  product Product? @relation("ProductNotifications", fields: [productId], references: [id])
  order   Order?   @relation("OrderNotifications", fields: [orderId], references: [id])
}

model VendorSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  storeName    String?
  banner       String?
  logo         String?
  
  businessName String?
  businessType String?
  taxId        String?
  website      String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor User @relation(fields: [userId], references: [id])
}

model Transaction {
  id        String          @id @default(cuid())
  vendorId  String
  type      TransactionType
  amount    Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())

  vendor User @relation(fields: [vendorId], references: [id])
}

// Removed duplicate - VariantCartItem already defined above

