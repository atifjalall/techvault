generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  phone             String?              // NEW - Phone number
  bio               String?              // NEW - Business description
  isVerified        Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  // NEW - Security settings
  twoFactorEnabled    Boolean   @default(false)
  phoneVerified       Boolean   @default(false)
  lastPasswordChange  DateTime? @default(now())
  
  // NEW - Business address as JSON
  businessAddress     Json?     // { street, city, postalCode, country }
  
  // NEW - Notification preferences as JSON  
  notificationSettings Json?    // { orderAlerts, marketingEmails, productUpdates, payoutNotifications }
  
  // NEW - Privacy settings as JSON
  privacySettings     Json?     // { profileVisibility, showEmail, showPhone }
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deleteAt          DateTime?
  role              Role      @default(CUSTOMER)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  // Vendor-specific
  products       Product[]       @relation("VendorProducts")
  transactions   Transaction[]
  vendorSettings VendorSettings?
  notifications  Notification[]  @relation("UserNotifications")
  
  // Payment methods
  savedPaymentMethods SavedPaymentMethod[]
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Payment Methods Model - ADD THIS
model SavedPaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  
  // SAFE DATA ONLY - No sensitive card info stored
  stripePaymentMethodId String // Stripe's tokenized payment method ID
  last4Digits   String   // Only last 4 digits for display (e.g., "4242")
  cardBrand     String   // Visa, Mastercard, Amex, etc.
  expiryMonth   Int      // For display/validation (1-12)
  expiryYear    Int      // For display/validation (e.g., 2025)
  
  // Billing information (safe to store)
  billingName   String
  billingEmail  String?
  billingAddress Json?   // {street, city, postalCode, country}
  
  // Metadata
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  nickname      String?  // User-friendly name like "Personal Card"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([stripePaymentMethodId])
}

// E-commerce Models
model Category {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  description  String?
  image        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id])
  products  Product[] @relation("SubcategoryProducts")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[] // relation back to products
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  comparePrice   Decimal?  @db.Decimal(10, 2)
  images         String[]
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id])
  modelNumber    String?
  specifications Json?
  stock          Int       @default(0)
  lowStockAlert  Int       @default(10)
  isActive       Boolean   @default(true)
  featured       Boolean   @default(false)
  newArrival     Boolean   @default(false)
  storage        String?
  length         String?
  views          Int       @default(0)
  sold           Int       @default(0)
  returnable     Boolean   @default(true)
  deliveryDays   Int?
  warranty       String?
  weight         String?
  dimensions     String?
  tags           String[]
  color          String?
  material       String?
  deletedAt      DateTime? // ADD THIS LINE

  categoryId    String
  subcategoryId String?
  vendorId      String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?   @relation("SubcategoryProducts", fields: [subcategoryId], references: [id])
  vendor        User           @relation("VendorProducts", fields: [vendorId], references: [id]) // Make vendorId required
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[] @relation("ProductWishlistItems")
  notifications Notification[] @relation("ProductNotifications")
  colors        ProductColor[]
}

// New model for product colors
model ProductColor {
  id        String   @id @default(cuid())
  productId String
  color     String      // e.g., "Red", "Blue", "Black"
  image     String      // URL to color image (Cloudinary)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, color]) // Each product can have a color only once
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductWishlistItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid()) // ADD THIS LINE
  userId          String
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(10, 2)
  shippingAddress Json
  paymentIntentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
  notifications  Notification[] @relation("OrderNotifications")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Notification {
  id          String      @id @default(cuid())
  userId      String?     // Who should receive the notification (optional for admin-wide notifications)
  productId   String?     // Optional, for product-related notifications
  orderId     String?     // Optional, for order-related notifications
  type        NotificationType
  severity    NotificationSeverity @default(INFO)
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User?    @relation("UserNotifications", fields: [userId], references: [id])
  product Product? @relation("ProductNotifications", fields: [productId], references: [id])
  order   Order?   @relation("OrderNotifications", fields: [orderId], references: [id])
}

enum NotificationType {
  LOW_STOCK
  NEW_ORDER
  ORDER_UPDATED
  NEW_REVIEW
  SYSTEM_ALERT
}

enum NotificationSeverity {
  INFO       // General info
  WARNING    // Needs attention (like low stock)
  CRITICAL   // Urgent (like stock=0 or order failed)
}

// Vendor-specific models
model VendorSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  storeName    String?
  banner       String?
  logo         String?
  
  // NEW - Business information
  businessName String?  // Legal business name
  businessType String?  // Business category (Electronics Retail, Online Store, etc.)
  taxId        String?  // VAT/Tax ID number (e.g., DE123456789)
  website      String?  // Business website URL
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor User @relation(fields: [userId], references: [id])
}

model Transaction {
  id        String          @id @default(cuid())
  vendorId  String
  type      TransactionType
  amount    Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())

  vendor User @relation(fields: [vendorId], references: [id])
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}