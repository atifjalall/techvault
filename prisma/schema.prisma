enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKAGING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  RETURNED
  EXCHANGE_REQUESTED
  ON_HOLD
  REQUIRES_ACTION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}