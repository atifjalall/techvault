  INVENTORY_WARNING
  COMPETITOR_PRICE_ALERT
  SEASONAL_DEMAND_FORECAST
  
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_PACKED
  ORDER_SHIPPED
